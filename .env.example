# =============================================================================
# Nexus ERP — Environment variables (copy to .env and fill in real values)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Odoo)
# -----------------------------------------------------------------------------
POSTGRES_DB=nexus_erp
POSTGRES_USER=odoo
# REQUIRED: change to a strong password before first startup
POSTGRES_PASSWORD=odoo_secret

# -----------------------------------------------------------------------------
# Odoo
# -----------------------------------------------------------------------------
ODOO_ADMIN_PASSWORD=admin

# Public domain for HTTPS / email links (no scheme, no port).
# Example: ODOO_DOMAIN=erp.example.com
ODOO_DOMAIN=

# Email for Let's Encrypt certificate notifications.
# Example: ACME_EMAIL=admin@example.com
ACME_EMAIL=

# For dev/test self-signed HTTPS mode (no domain required).
# Set to the server public IP address.
SERVER_IP=127.0.0.1

# -----------------------------------------------------------------------------
# ERPNext 15
# -----------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=erpnext_secret
ERPNEXT_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# n8n automation (REQUIRED: set strong values)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://your-public-host:5678/
N8N_ENCRYPTION_KEY=change_me_to_a_random_hex_string
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
AI_SERVICES_API_KEY=change_me_shared_secret
# Comma-separated list of allowed origins for the AI services API.
# Empty = browser CORS disabled (server-to-server calls still work).
# Example: AI_CORS_ORIGINS=https://erp.example.com,https://app.example.com
AI_CORS_ORIGINS=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
REQUEST_TIMEOUT=300

# -----------------------------------------------------------------------------
# Nexus SaaS / Billing
# -----------------------------------------------------------------------------
SAAS_BASE_DOMAIN=erp.example.com
SAAS_SELF_SERVICE_SIGNUP=true

# Cloudflare DNS — used to create tenant subdomains automatically.
# Token needs Zone:Read and DNS:Edit permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=app.erp.example.com

# Stripe billing (used by nexus_saas_billing module).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
