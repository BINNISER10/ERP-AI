<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_copilot_insight_list" model="ir.ui.view">
        <field name="name">copilot.insight.list</field>
        <field name="model">copilot.insight</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="persona"/>
                <field name="name"/>
                <field name="source"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_copilot_insight_form" model="ir.ui.view">
        <field name="name">copilot.insight.form</field>
        <field name="model">copilot.insight</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="persona"/>
                        <field name="insight_text"/>
                        <field name="warm_message"/>
                        <field name="source"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_copilot_support_incident_list" model="ir.ui.view">
        <field name="name">copilot.support.incident.list</field>
        <field name="model">copilot.support.incident</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="source"/>
                <field name="severity"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_copilot_support_incident_form" model="ir.ui.view">
        <field name="name">copilot.support.incident.form</field>
        <field name="model">copilot.support.incident</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source"/>
                        <field name="severity"/>
                        <field name="state"/>
                        <field name="description"/>
                        <field name="traceback"/>
                        <field name="notify_users"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_copilot_behavior_log_list" model="ir.ui.view">
        <field name="name">copilot.behavior.log.list</field>
        <field name="model">copilot.behavior.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <field name="action"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_copilot_dashboard_insights" model="ir.actions.act_window">
        <field name="name">Executive Insights</field>
        <field name="res_model">copilot.insight</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('persona', '=', 'ceo')]</field>
        <field name="context">{'default_persona': 'ceo'}</field>
    </record>

    <record id="action_copilot_incidents" model="ir.actions.act_window">
        <field name="name">Support Incidents</field>
        <field name="res_model">copilot.support.incident</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_copilot_behavior_log" model="ir.actions.act_window">
        <field name="name">Behavior Logs</field>
        <field name="res_model">copilot.behavior.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_copilot_dashboard"
        name="Executive Insights"
        parent="menu_copilot_root"
        action="action_copilot_dashboard_insights"
        sequence="30"/>

    <menuitem
        id="menu_copilot_incidents"
        name="Incidents"
        parent="menu_copilot_root"
        action="action_copilot_incidents"
        sequence="40"/>

    <menuitem
        id="menu_copilot_behavior_log"
        name="Behavior Logs"
        parent="menu_copilot_root"
        action="action_copilot_behavior_log"
        sequence="50"/>
</odoo>
