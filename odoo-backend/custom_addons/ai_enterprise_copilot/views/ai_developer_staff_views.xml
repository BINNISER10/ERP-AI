<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ Nexus AI Developer Staff Form ════════════════ -->
    <record id="view_nexus_ai_developer_staff_form" model="ir.ui.view">
        <field name="name">nexus.ai.developer.staff.form</field>
        <field name="model">nexus.ai.developer.staff</field>
        <field name="arch" type="xml">
            <form string="AI Developer Staff / مطور أودو ومستشار الأعمال الذكي">
                <header>
                    <button name="action_ask_ai_developer" 
                            string="⚡ استشارة المطور الذكي وحل المتطلب (Ask AI Developer)" 
                            type="object" 
                            class="btn-primary btn-lg font-weight-bold"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,answered"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="name" placeholder="عنوان الاستشارة أو المتطلب البرمجي..."/>
                        </h1>
                    </div>

                    <!-- Persona and Context Selectors -->
                    <div class="card border-primary p-3 mb-3 bg-light shadow-sm" style="border-radius: 8px;">
                        <group>
                            <group string="1. اختر تخصص المستشار المطلوب">
                                <field name="developer_persona" widget="radio"/>
                            </group>
                            <group string="2. الموديول والمجال المستهدف">
                                <field name="context_module"/>
                                <field name="user_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </div>

                    <!-- Prompt and Error Section -->
                    <group string="3. تفاصيل السؤال أو المتطلب البرمجي والتشغيلي">
                        <field name="prompt" widget="text" nolabel="1" placeholder="اكتب سؤالك هنا... مثال: كيف أقوم بإضافة حقل لحساب العمولة تلقائياً عند اعتماد الفاتورة؟ أو: اكتب لي استعلام SQL لمقارنة المبيعات بين الفروع..."/>
                    </group>

                    <group string="4. رسالة الخطأ للتشخيص الفوري (Error Traceback - اختياري)">
                        <field name="error_traceback" widget="text" nolabel="1" placeholder="إذا واجهت أي رسالة خطأ، الصقها هنا وسيقوم المطور الذكي بفحص السبب الجذري وتقديم الحل البرمجي الفوري..."/>
                    </group>

                    <!-- Solutions Output Section (Visible when answered) -->
                    <notebook invisible="state != 'answered'">
                        <page string="💡 الحل وشرح المطور الذكي">
                            <field name="ai_response_html" widget="html" readonly="1" nolabel="1"/>
                            <div class="mt-3">
                                <field name="recommended_actions_html" widget="html" readonly="1" nolabel="1"/>
                            </div>
                        </page>
                        <page string="💻 الكود البرمجي المولد (Code / Query)">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-dark me-2 font-weight-bold" style="font-size: 13px;">
                                    <field name="generated_code_type" readonly="1"/>
                                </span>
                                <small class="text-muted">يمكنك نسخ هذا الكود واستخدامه مباشرة في Server Actions أو SQL أو قوالب النظام.</small>
                            </div>
                            <field name="generated_code" widget="text" class="font-monospace" style="background-color: #1E1E1E; color: #D4D4D4; font-family: monospace; padding: 15px; border-radius: 8px; font-size: 14px; min-height: 200px;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════ List View ════════════════ -->
    <record id="view_nexus_ai_developer_staff_tree" model="ir.ui.view">
        <field name="name">nexus.ai.developer.staff.list</field>
        <field name="model">nexus.ai.developer.staff</field>
        <field name="arch" type="xml">
            <list string="AI Developer Staff Sessions">
                <field name="name"/>
                <field name="developer_persona"/>
                <field name="context_module"/>
                <field name="user_id"/>
                <field name="state" widget="badge" decoration-success="state == 'answered'" decoration-info="state == 'draft'"/>
                <field name="create_date" string="التاريخ"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nexus_ai_developer_staff" model="ir.actions.act_window">
        <field name="name">AI Developer Staff / مطور النظام الذكي</field>
        <field name="res_model">nexus.ai.developer.staff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                استشر مطور أودو ومستشار الأعمال الذكي لحل المشاكل، كتابة الأكواد، وتطوير النظام!
            </p>
        </field>
    </record>

    <!-- Menu Item under AI Copilot -->
    <menuitem id="menu_nexus_ai_developer_staff"
              name="👨‍💻 مطور النظام ومستشار الأعمال الذكي"
              parent="ai_enterprise_copilot.menu_copilot_root"
              action="action_nexus_ai_developer_staff"
              sequence="2"/>
</odoo>
