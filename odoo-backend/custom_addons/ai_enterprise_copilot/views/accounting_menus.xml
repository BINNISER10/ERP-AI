<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- �═══════════════════════════════════════════════════════════════════
         Nexus Unified Accounting Menu Layer
         Hides ALL native Odoo accounting menus and replaces them with
         a single "Nexus Finance" experience. The user never sees
         duplicate or conflicting entries.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Hide ALL native Odoo accounting menus (top-level + sub-menus) -->
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_account_report')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance_receivable')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance_payable')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance_configuration')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance_entries')]"/>
        <value eval="{'active': False}"/>
    </function>
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('account.menu_finance_management')]"/>
        <value eval="{'active': False}"/>
    </function>

    <!-- Top-level Nexus Finance app (replaces Invoicing) -->
    <record id="action_nexus_accounting_dashboard" model="ir.actions.act_window">
        <field name="name">لوحة التحكم المالية</field>
        <field name="res_model">copilot.insight</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('persona','in',['cfo','ceo'])]</field>
        <field name="context">{'default_persona': 'cfo'}</field>
    </record>

    <!-- �══════ Financial Reports (Powered by Nexus Engine) ═══════ -->
    <record id="action_nexus_report_balance_sheet" model="ir.actions.act_window">
        <field name="name">الميزانية العمومية / Balance Sheet</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'balance_sheet'}</field>
    </record>

    <record id="action_nexus_report_profit_loss" model="ir.actions.act_window">
        <field name="name">قائمة الدخل / Profit &amp; Loss</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'profit_loss'}</field>
    </record>

    <record id="action_nexus_report_cash_flow" model="ir.actions.act_window">
        <field name="name">التدفقات النقدية / Cash Flow</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'cash_flow'}</field>
    </record>

    <record id="action_nexus_report_trial_balance" model="ir.actions.act_window">
        <field name="name">ميزان المراجعة / Trial Balance</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'trial_balance'}</field>
    </record>

    <record id="action_nexus_report_general_ledger" model="ir.actions.act_window">
        <field name="name">دفتر الأستاذ العام / General Ledger</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'general_ledger'}</field>
    </record>

    <record id="action_nexus_report_aging_receivable" model="ir.actions.act_window">
        <field name="name">أعمار الذمم المدينة / Receivable Aging</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'aging_receivable'}</field>
    </record>

    <record id="action_nexus_report_aging_payable" model="ir.actions.act_window">
        <field name="name">أعمار الذمم الدائنة / Payable Aging</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'aging_payable'}</field>
    </record>

    <record id="action_nexus_report_budget_variance" model="ir.actions.act_window">
        <field name="name">انحراف الميزانية / Budget Variance</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'budget_variance'}</field>
    </record>

    <record id="action_nexus_report_cost_center" model="ir.actions.act_window">
        <field name="name">تقرير مراكز التكلفة / Cost Center Report</field>
        <field name="res_model">nexus.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'cost_center'}</field>
    </record>

    <!-- �══════ Operations (Customer Invoices, Vendor Bills, Payments) ═══════ -->
    <record id="action_nexus_customer_invoices" model="ir.actions.act_window">
        <field name="name">فواتير العملاء / Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('move_type','=','out_invoice')]</field>
        <field name="context">{'default_move_type':'out_invoice'}</field>
    </record>

    <record id="action_nexus_vendor_bills" model="ir.actions.act_window">
        <field name="name">فواتير الموردين / Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('move_type','=','in_invoice')]</field>
        <field name="context">{'default_move_type':'in_invoice'}</field>
    </record>

    <record id="action_nexus_payments" model="ir.actions.act_window">
        <field name="name">المدفوعات / Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="action_nexus_bank_statements" model="ir.actions.act_window">
        <field name="name">كشوف الحسابات البنكية / Bank Statements</field>
        <field name="res_model">account.bank.statement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- �══════ Masters (Chart of Accounts, Journals, Taxes, etc.) ═══════ -->
    <record id="action_nexus_chart_of_accounts" model="ir.actions.act_window">
        <field name="name">دليل الحسابات / Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_nexus_journals" model="ir.actions.act_window">
        <field name="name">دفاتر اليومية / Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nexus_bank_accounts" model="ir.actions.act_window">
        <field name="name">الحسابات البنكية / Bank Accounts</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','bank')]</field>
        <field name="context">{'default_type':'bank'}</field>
    </record>

    <record id="action_nexus_cash_registers" model="ir.actions.act_window">
        <field name="name">الخزائن النقدية / Cash Registers</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','cash')]</field>
        <field name="context">{'default_type':'cash'}</field>
    </record>

    <record id="action_nexus_taxes" model="ir.actions.act_window">
        <field name="name">الضرائب / Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════ MENU STRUCTURE ════════════════ -->
    <menuitem
        id="menu_nexus_accounting_root"
        name="المالية / Finance"
        web_icon="account,static/description/icon.png"
        sequence="5"
        action="action_nexus_accounting_dashboard"/>

    <!-- Setup submenu -->
    <menuitem
        id="menu_nexus_accounting_setup"
        name="الإعداد / Setup"
        parent="menu_nexus_accounting_root"
        sequence="5"/>

    <menuitem
        id="menu_nexus_accounting_setup_journey"
        name="رحلة التأسيس / Setup Journey"
        parent="menu_nexus_accounting_setup"
        action="action_nexus_setup_journey"
        sequence="10"/>

    <menuitem
        id="menu_nexus_accounting_settings"
        name="الإعدادات / Settings"
        parent="menu_nexus_accounting_setup"
        action="action_copilot_config"
        sequence="20"/>

    <!-- Masters submenu -->
    <menuitem
        id="menu_nexus_accounting_masters"
        name="الأساسيات / Masters"
        parent="menu_nexus_accounting_root"
        sequence="10"/>

    <menuitem
        id="menu_nexus_accounting_chart"
        name="دليل الحسابات / Chart of Accounts"
        parent="menu_nexus_accounting_masters"
        action="action_nexus_chart_of_accounts"
        sequence="10"/>

    <menuitem
        id="menu_nexus_accounting_journals"
        name="دفاتر اليومية / Journals"
        parent="menu_nexus_accounting_masters"
        action="action_nexus_journals"
        sequence="20"/>

    <menuitem
        id="menu_nexus_accounting_bank"
        name="الحسابات البنكية / Bank Accounts"
        parent="menu_nexus_accounting_masters"
        action="action_nexus_bank_accounts"
        sequence="30"/>

    <menuitem
        id="menu_nexus_accounting_cash"
        name="الخزائن النقدية / Cash Registers"
        parent="menu_nexus_accounting_masters"
        action="action_nexus_cash_registers"
        sequence="40"/>

    <menuitem
        id="menu_nexus_accounting_taxes"
        name="الضرائب / Taxes"
        parent="menu_nexus_accounting_masters"
        action="action_nexus_taxes"
        sequence="50"/>

    <!-- Transactions submenu -->
    <menuitem
        id="menu_nexus_accounting_transactions"
        name="المعاملات / Transactions"
        parent="menu_nexus_accounting_root"
        sequence="15"/>

    <menuitem
        id="menu_nexus_accounting_invoices"
        name="فواتير العملاء / Customer Invoices"
        parent="menu_nexus_accounting_transactions"
        action="action_nexus_customer_invoices"
        sequence="10"/>

    <menuitem
        id="menu_nexus_accounting_bills"
        name="فواتير الموردين / Vendor Bills"
        parent="menu_nexus_accounting_transactions"
        action="action_nexus_vendor_bills"
        sequence="20"/>

    <menuitem
        id="menu_nexus_accounting_payments"
        name="المدفوعات / Payments"
        parent="menu_nexus_accounting_transactions"
        action="action_nexus_payments"
        sequence="30"/>

    <menuitem
        id="menu_nexus_accounting_statements"
        name="كشوف الحسابات البنكية / Bank Statements"
        parent="menu_nexus_accounting_transactions"
        action="action_nexus_bank_statements"
        sequence="40"/>

    <!-- ═══════ Financial Reports submenu (Powered by Nexus Engine) ═══════ -->
    <menuitem
        id="menu_nexus_accounting_reports"
        name="التقارير المالية / Financial Reports"
        parent="menu_nexus_accounting_root"
        sequence="20"/>

    <menuitem
        id="menu_nexus_report_balance_sheet"
        name="الميزانية العمومية / Balance Sheet"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_balance_sheet"
        sequence="10"/>

    <menuitem
        id="menu_nexus_report_profit_loss"
        name="قائمة الدخل / Profit &amp; Loss"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_profit_loss"
        sequence="20"/>

    <menuitem
        id="menu_nexus_report_cash_flow"
        name="التدفقات النقدية / Cash Flow"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_cash_flow"
        sequence="30"/>

    <menuitem
        id="menu_nexus_report_trial_balance"
        name="ميزان المراجعة / Trial Balance"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_trial_balance"
        sequence="40"/>

    <menuitem
        id="menu_nexus_report_general_ledger"
        name="دفتر الأستاذ العام / General Ledger"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_general_ledger"
        sequence="50"/>

    <menuitem
        id="menu_nexus_report_aging_receivable"
        name="أعمار الذمم المدينة / Receivable Aging"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_aging_receivable"
        sequence="60"/>

    <menuitem
        id="menu_nexus_report_aging_payable"
        name="أعمار الذمم الدائنة / Payable Aging"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_aging_payable"
        sequence="70"/>

    <menuitem
        id="menu_nexus_report_budget_variance"
        name="انحراف الميزانية / Budget Variance"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_budget_variance"
        sequence="80"/>

    <menuitem
        id="menu_nexus_report_cost_center"
        name="تقرير مراكز التكلفة / Cost Center Report"
        parent="menu_nexus_accounting_reports"
        action="action_nexus_report_cost_center"
        sequence="90"/>

</odoo>
