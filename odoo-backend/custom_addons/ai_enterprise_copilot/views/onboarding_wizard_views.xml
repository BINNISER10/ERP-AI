<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ Nexus Smart Conversational Onboarding Wizard ════════════════ -->
    <record id="view_nexus_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">nexus.onboarding.wizard.form</field>
        <field name="model">nexus.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Nexus Smart Onboarding / رحلة التأسيس الذكي">
                <header>
                    <button name="action_prev_step" 
                            string="➡️ السابق" 
                            type="object"
                            class="btn-secondary" 
                            invisible="current_step == 'welcome'"/>
                    
                    <button name="action_step_forward" 
                            string="التالي ⬅️" 
                            type="object" 
                            class="btn-primary" 
                            invisible="current_step == 'welcome' or current_step == 'review'"/>
                    
                    <button name="action_apply_and_start" 
                            string="🎉 تأكيد وتطبيق الإعدادات وتشغيل النظام فوراً" 
                            type="object"
                            class="btn-success" 
                            invisible="current_step != 'review'"/>
                </header>

                <sheet>
                    <!-- Visual Progress Bar on all steps except Welcome -->
                    <field name="step_progress_html" widget="html" readonly="1" nolabel="1"/>

                    <!-- ──────────────── STEP 0: Welcome ──────────────── -->
                    <div invisible="current_step != 'welcome'" class="text-center py-4">
                        <div class="mb-3">
                            <span class="fa fa-magic fa-4x text-primary"/>
                        </div>
                        <h1 class="mb-3" style="color: #0B3D2E; font-weight: bold;">مرحباً بك في رحلة التأسيس الذكي لمنشأتك 🚀</h1>
                        <p class="text-muted lead mb-4">
                            سنأخذ بيدك خطوة بخطوة بالذكاء الاصطناعي لتجهيز المحاسبة، الضرائب، الفواتير، ونقاط البيع في دقائق معدودة (التالي ⬅️ ثم التالي ⬅️).
                        </p>
                        
                        <div class="row justify-content-center mb-4">
                            <div class="col-md-3 col-6 text-center mb-3">
                                <div class="p-3 border rounded shadow-sm bg-light h-100">
                                    <span class="fa fa-building fa-2x text-primary mb-2"/>
                                    <h6 class="mb-1 font-weight-bold">1. ملف وهوية الشركة</h6>
                                    <small class="text-muted">الاسم والنشاط والفرع</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 text-center mb-3">
                                <div class="p-3 border rounded shadow-sm bg-light h-100">
                                    <span class="fa fa-shopping-cart fa-2x text-success mb-2"/>
                                    <h6 class="mb-1 font-weight-bold">2. المبيعات ونقاط البيع</h6>
                                    <small class="text-muted">الفروع والمستودعات والكاشير</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 text-center mb-3">
                                <div class="p-3 border rounded shadow-sm bg-light h-100">
                                    <span class="fa fa-calculator fa-2x text-warning mb-2"/>
                                    <h6 class="mb-1 font-weight-bold">3. المالية والضرائب</h6>
                                    <small class="text-muted">الضريبة وZATCA والبنوك</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 text-center mb-3">
                                <div class="p-3 border rounded shadow-sm bg-light h-100">
                                    <span class="fa fa-cogs fa-2x text-info mb-2"/>
                                    <h6 class="mb-1 font-weight-bold">4. الفريق والمسيرات</h6>
                                    <small class="text-muted">الرواتب والإطلاق الفوري</small>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3">
                            <button name="action_step_forward" 
                                    string="🚀 ابدأ رحلة التأسيس السريع الآن (التالي ⬅️)" 
                                    type="object"
                                    class="btn btn-primary btn-lg px-5 py-3 shadow"
                                    style="font-size: 18px; font-weight: bold; border-radius: 8px;"/>
                        </div>
                    </div>

                    <!-- ──────────────── STEP 1: Business Profile ──────────────── -->
                    <div invisible="current_step != 'business_profile'">
                        <!-- Conversational AI Speech Bubble -->
                        <div class="alert alert-primary border-0 shadow-sm p-3 mb-3 d-flex align-items-start" style="border-radius: 10px; background-color: #EBF3FA;">
                            <span class="fa fa-robot fa-2x text-primary me-3 mt-1"/>
                            <div>
                                <h6 class="font-weight-bold text-primary mb-1">المستشار الذكي يسأل:</h6>
                                <p class="mb-0 text-dark">
                                    « مرحباً! لتهيئة دليل الحسابات وقوالب الفواتير، ما هو الاسم التجاري لمنشأتكم والنشاط الذي تعملون به؟ 
                                    (يمكنك أيضاً سحب وإفلات صورة السجل التجاري وسأقوم بتعبئة كل شيء عنك تلقائياً!) »
                                </p>
                            </div>
                        </div>

                        <!-- Auto-fill Document Dropzone -->
                        <div class="card border-dashed p-3 mb-3 bg-light text-center" style="border: 2px dashed #0B3D2E; border-radius: 10px;">
                            <div class="row align-items-center">
                                <div class="col-md-7 text-start">
                                    <span class="fa fa-id-card text-success fa-lg me-2"/>
                                    <strong class="text-dark">سحب وإفلات السجل التجاري / الشهادة الضريبية للملء الفوري:</strong>
                                    <div class="mt-2">
                                        <field name="document_file" widget="binary" filename="document_filename"/>
                                        <field name="document_filename" invisible="1"/>
                                    </div>
                                </div>
                                <div class="col-md-5 text-end mt-2 mt-md-0">
                                    <button name="action_auto_fill_from_document" 
                                            string="⚡ سحب البيانات من الوثيقة تلقائياً" 
                                            type="object" 
                                            class="btn btn-sm btn-outline-success font-weight-bold"
                                            invisible="not document_file"/>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group string="هوية المنشأة / Company Identity">
                                <field name="business_name" placeholder="مثال: شركة نكساس للتجارة" required="1"/>
                                <field name="business_name_ar" placeholder="الاسم التجاري بالعربية"/>
                                <field name="cr_number" placeholder="1010XXXXXX"/>
                                <field name="company_type" required="1"/>
                                <field name="industry_sector" required="1"/>
                            </group>
                            <group string="حجم العمل والمقر / Scale &amp; City">
                                <field name="company_size" required="1"/>
                                <field name="employee_count"/>
                                <field name="city" placeholder="الرياض / جدة / الدمام"/>
                                <field name="expected_monthly_transactions"/>
                            </group>
                        </group>

                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-3 small d-flex align-items-center">
                            <span class="fa fa-lightbulb-o fa-lg text-warning me-2"/>
                            <span>💡 <strong>نصيحة المنظومة:</strong> سنقوم ببناء دليل حسابات مخصص تماماً للنشاط المختار (مطاعم، تجزئة، مقاولات، إلخ) وفق معايير المحاسبة الدولية IFRS.</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <button name="action_prev_step" string="➡️ السابق" type="object" class="btn btn-secondary"/>
                            <button name="action_step_forward" string="التالي: العمليات والمبيعات ⬅️" type="object" class="btn btn-primary btn-lg px-4"/>
                        </div>
                    </div>

                    <!-- ──────────────── STEP 2: Operations ──────────────── -->
                    <div invisible="current_step != 'operations'">
                        <!-- Conversational AI Speech Bubble -->
                        <div class="alert alert-primary border-0 shadow-sm p-3 mb-3 d-flex align-items-start" style="border-radius: 10px; background-color: #EBF3FA;">
                            <span class="fa fa-robot fa-2x text-primary me-3 mt-1"/>
                            <div>
                                <h6 class="font-weight-bold text-primary mb-1">المستشار الذكي يسأل:</h6>
                                <p class="mb-0 text-dark">
                                    « كيف تبيعون منتجاتكم وخدماتكم للعملاء؟ هل لديكم نقاط بيع (كاشير)، مستودعات تخزين، أو فروع متعددة؟ »
                                </p>
                            </div>
                        </div>

                        <group>
                            <group string="قنوات البيع المعتمدة / Sales Channels">
                                <field name="has_pos"/>
                                <field name="pos_count" invisible="not has_pos"/>
                                <field name="has_online_sales"/>
                                <field name="sells_products"/>
                                <field name="sells_services"/>
                            </group>
                            <group string="الفروع والمستودعات / Branches &amp; Warehouses">
                                <field name="has_multi_branch"/>
                                <field name="branch_count" invisible="not has_multi_branch"/>
                                <field name="has_warehouses"/>
                                <field name="warehouse_count" invisible="not has_warehouses"/>
                            </group>
                        </group>

                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-3 small d-flex align-items-center">
                            <span class="fa fa-lightbulb-o fa-lg text-warning me-2"/>
                            <span>💡 <strong>نصيحة المنظومة:</strong> بتفعيل نقاط البيع، سيتم تجهيز نظام الكاشير ليعمل Offline-first بالكامل بدون إنترنت مع دعم أجهزة الدفع ومدى وشاشات المطبخ KDS.</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <button name="action_prev_step" string="➡️ السابق (ملف الشركة)" type="object" class="btn btn-secondary"/>
                            <button name="action_step_forward" string="التالي: الضرائب والمالية ⬅️" type="object" class="btn btn-primary btn-lg px-4"/>
                        </div>
                    </div>

                    <!-- ──────────────── STEP 3: Financial ──────────────── -->
                    <div invisible="current_step != 'financial'">
                        <!-- Conversational AI Speech Bubble -->
                        <div class="alert alert-primary border-0 shadow-sm p-3 mb-3 d-flex align-items-start" style="border-radius: 10px; background-color: #EBF3FA;">
                            <span class="fa fa-robot fa-2x text-primary me-3 mt-1"/>
                            <div>
                                <h6 class="font-weight-bold text-primary mb-1">المستشار الذكي يسأل:</h6>
                                <p class="mb-0 text-dark">
                                    « هل منشأتكم مسجلة في ضريبة القيمة المضافة ومتطلبات الفوترة الإلكترونية (ZATCA Phase 2)؟ »
                                </p>
                            </div>
                        </div>

                        <group>
                            <group string="الضرائب والفوترة الإلكترونية / Tax &amp; ZATCA">
                                <field name="vat_registered"/>
                                <field name="vat_rate" invisible="not vat_registered"/>
                                <field name="vat_number" invisible="not vat_registered" placeholder="300000000000003"/>
                                <field name="zatca_required" invisible="not vat_registered"/>
                                <field name="accounting_standard"/>
                            </group>
                            <group string="الحسابات البنكية والمالية / Banking">
                                <field name="bank_account_count"/>
                                <field name="cash_register_count"/>
                                <field name="has_multi_currency"/>
                                <field name="fiscal_year_start"/>
                            </group>
                        </group>

                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-3 small d-flex align-items-center">
                            <span class="fa fa-lightbulb-o fa-lg text-warning me-2"/>
                            <span>💡 <strong>نصيحة المنظومة:</strong> بتفعيل ZATCA، سيقوم النظام تلقائياً بتوليد فواتير إلكترونية مشفرة (XML C14N + SHA-256) مع رمز الاستجابة السريعة QR المتوافق مع هيئة الزكاة.</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <button name="action_prev_step" string="➡️ السابق (العمليات)" type="object" class="btn btn-secondary"/>
                            <button name="action_step_forward" string="التالي: الفريق والميزات ⬅️" type="object" class="btn btn-primary btn-lg px-4"/>
                        </div>
                    </div>

                    <!-- ──────────────── STEP 4: Advanced ──────────────── -->
                    <div invisible="current_step != 'advanced'">
                        <!-- Conversational AI Speech Bubble -->
                        <div class="alert alert-primary border-0 shadow-sm p-3 mb-3 d-flex align-items-start" style="border-radius: 10px; background-color: #EBF3FA;">
                            <span class="fa fa-robot fa-2x text-primary me-3 mt-1"/>
                            <div>
                                <h6 class="font-weight-bold text-primary mb-1">المستشار الذكي يسأل:</h6>
                                <p class="mb-0 text-dark">
                                    « كم عدد موظفيكم وهل ترغبون بتفعيل مسيرات الرواتب لحماية الأجور (WPS) وإدارة المشاريع أو الأصول؟ »
                                </p>
                            </div>
                        </div>

                        <group>
                            <group string="فريق العمل والرواتب / HR &amp; Payroll">
                                <field name="gosi_number" placeholder="700XXXXXXX"/>
                                <field name="needs_hr"/>
                                <field name="contact_phone" placeholder="+966 5X XXX XXXX"/>
                                <field name="onboarding_notes" placeholder="أي متطلبات أو ملاحظات إضافية..."/>
                            </group>
                            <group string="الأنظمة التشغيلية المتقدمة / Advanced Modules">
                                <field name="needs_projects"/>
                                <field name="needs_assets"/>
                                <field name="needs_manufacturing"/>
                                <field name="needs_fleet"/>
                                <field name="has_existing_data"/>
                            </group>
                        </group>

                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-3 small d-flex align-items-center">
                            <span class="fa fa-lightbulb-o fa-lg text-warning me-2"/>
                            <span>💡 <strong>نصيحة المنظومة:</strong> سنقوم بإنشاء هيكل الأقسام الإدارية ومسيرات الرواتب المعتمدة من وزارة الموارد البشرية تلقائياً.</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <button name="action_prev_step" string="➡️ السابق (المالية)" type="object" class="btn btn-secondary"/>
                            <button name="action_step_forward" string="التالي: المراجعة والإطلاق ⬅️" type="object" class="btn btn-primary btn-lg px-4"/>
                        </div>
                    </div>

                    <!-- ──────────────── STEP 5: Review ──────────────── -->
                    <div invisible="current_step != 'review'">
                        <!-- Conversational AI Celebration Header -->
                        <div class="alert alert-success border-0 shadow-sm p-3 mb-3 d-flex align-items-start" style="border-radius: 10px; background-color: #E8F5E9;">
                            <span class="fa fa-check-circle fa-2x text-success me-3 mt-1"/>
                            <div>
                                <h5 class="font-weight-bold text-success mb-1">المستشار الذكي يهنئك! 🎯</h5>
                                <p class="mb-0 text-dark">
                                    « تم فحص جميع إجاباتك وتهيئة خطة التأسيس الشاملة لمنشأة <b>(<field name="business_name"/>)</b> بنجاح.
                                    درجة الجاهزية الآن <b>100%</b> ونظامك جاهز للتشغيل الفوري بضغطة زر واحدة! »
                                </p>
                            </div>
                        </div>

                        <group>
                            <group string="ملخص الإعدادات التي سيتم تطبيقها">
                                <field name="configuration_summary" nolabel="1" readonly="1" class="oe_read_only"/>
                            </group>
                            <group string="الأنظمة والموديولات التي تم تجهيزها">
                                <field name="selected_modules" nolabel="1" readonly="1"/>
                                <div class="alert alert-info mt-3 py-2 px-3 small">
                                    🚀 <strong>بضغطة زر سيتم:</strong>
                                    <ul class="mb-0 ps-3 mt-1">
                                        <li>تأسيس دليل الحسابات المطابق للنشاط</li>
                                        <li>إنشاء الحسابات البنكية والخزائن ونقاط البيع</li>
                                        <li>تفعيل الضرائب وربط ZATCA Phase 2</li>
                                        <li>تهيئة المستودعات وأقسام الموظفين</li>
                                    </ul>
                                </div>
                            </group>
                        </group>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <button name="action_prev_step" string="➡️ السابق (تعديل البيانات)" type="object" class="btn btn-secondary"/>
                            <button name="action_apply_and_start" 
                                    string="🎉 تأكيد وتأسيس النظام فوراً وإطلاق رحلة العمل ⬅️" 
                                    type="object" 
                                    class="btn btn-success btn-lg px-5 py-3 shadow"
                                    style="font-size: 17px; font-weight: bold; border-radius: 8px;"/>
                        </div>
                    </div>

                </sheet>

                <footer>
                    <button name="action_prev_step" 
                            string="➡️ السابق" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="current_step == 'welcome'"/>
                    
                    <button name="action_step_forward" 
                            string="التالي ⬅️" 
                            type="object" 
                            class="btn-primary" 
                            invisible="current_step == 'welcome' or current_step == 'review'"/>
                    
                    <button name="action_apply_and_start" 
                            string="🎉 تطبيق وتشغيل النظام الآن" 
                            type="object" 
                            class="btn-success" 
                            invisible="current_step != 'review'"/>
                    
                    <button string="إغلاق / Close" 
                            class="btn-outline-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
