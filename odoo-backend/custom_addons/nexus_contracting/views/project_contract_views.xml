<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_contract_tree" model="ir.ui.view">
        <field name="name">project.contract.tree</field>
        <field name="model">project.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="contract_value"/>
                <field name="completion_percentage"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_project_contract_form" model="ir.ui.view">
        <field name="name">project.contract.form</field>
        <field name="model">project.contract</field>
        <field name="arch" type="xml">
            <form string="Construction Contract">
                <header>
                    <button name="action_start" type="object" string="Start" states="draft" class="oe_highlight"/>
                    <button name="action_complete" type="object" string="Complete" states="in_progress" class="oe_highlight"/>
                    <button name="action_create_progress_invoice" type="object" string="Create Progress Invoice" states="completed" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,invoiced"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="contract_value"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="completion_percentage" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Sheets">
                            <field name="cost_sheet_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="percentage"/>
                                    <field name="cost"/>
                                    <field name="revenue"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Totals">
                            <group>
                                <field name="total_cost" readonly="1"/>
                                <field name="total_revenue" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">project.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_contracting_root" name="Contracting" sequence="70"/>
    <menuitem id="menu_project_contract" name="Contracts" parent="menu_contracting_root" action="action_project_contract" sequence="10"/>
</odoo>
