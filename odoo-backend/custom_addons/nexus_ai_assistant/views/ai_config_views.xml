<odoo>
    <record id="view_nexus_ai_config_list" model="ir.ui.view">
        <field name="name">nexus.ai.config.list</field>
        <field name="model">nexus.ai.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ai_service_url"/>
                <field name="ai_provider"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_ai_config_form" model="ir.ui.view">
        <field name="name">nexus.ai.config.form</field>
        <field name="model">nexus.ai.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ai_service_url"/>
                        <field name="ai_provider"/>
                        <field name="request_timeout"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nexus_ai_config" model="ir.actions.act_window">
        <field name="name">AI Assistant Configuration</field>
        <field name="res_model">nexus.ai.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
