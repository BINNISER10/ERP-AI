<odoo>
    <record id="view_nexus_ai_monitor_wizard" model="ir.ui.view">
        <field name="name">nexus.ai.monitor.wizard.form</field>
        <field name="model">nexus.ai.monitor.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <sheet>
                    <group string="Monitor Settings" invisible="state != 'input'">
                        <field name="monitor_type"/>
                        <field name="language"/>
                        <field name="date_from" invisible="monitor_type == 'reports'"/>
                        <field name="date_to" invisible="monitor_type == 'reports'"/>
                        <field name="role" invisible="monitor_type != 'reports'"/>
                        <field name="industry" invisible="monitor_type != 'reports'"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="AI Result" invisible="state != 'result'">
                        <field name="summary" string="Summary" readonly="1"/>
                        <field name="result_json" string="Details (JSON)" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Run AI Monitor" class="oe_highlight" invisible="state != 'input'"/>
                    <button string="Close" special="cancel" class="btn-secondary" invisible="state != 'result'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" invisible="state != 'input'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nexus_ai_monitor_wizard" model="ir.actions.act_window">
        <field name="name">AI Monitor</field>
        <field name="res_model">nexus.ai.monitor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
