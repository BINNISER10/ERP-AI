<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_unit_tree" model="ir.ui.view">
        <field name="name">property.unit.tree</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="unit_code"/>
                <field name="unit_type"/>
                <field name="area"/>
                <field name="rent_amount"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_property_unit_form" model="ir.ui.view">
        <field name="name">property.unit.form</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <form string="Property Unit">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="property_id"/>
                        <field name="unit_code"/>
                        <field name="unit_type"/>
                        <field name="area"/>
                        <field name="floor"/>
                        <field name="bedrooms"/>
                        <field name="bathrooms"/>
                        <field name="rent_amount"/>
                        <field name="sale_price"/>
                        <field name="state"/>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_unit" model="ir.actions.act_window">
        <field name="name">Property Units</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_real_estate_root" name="Real Estate" sequence="60"/>
    <menuitem id="menu_property_unit" name="Property Units" parent="menu_real_estate_root" action="action_property_unit" sequence="10"/>
</odoo>
