<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_saas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.saas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']/.." position="inside">
                <div name="saas_settings">
                    <block title="Nexus SaaS" name="nexus_saas_settings">
                        <setting help="Base domain used for new tenant subdomains, e.g. nexus-engine.app">
                            <field name="saas_base_domain"/>
                        </setting>
                        <setting help="Enable public self-service signup page">
                            <field name="saas_self_service_signup"/>
                        </setting>
                    </block>
                    <block title="Cloudflare DNS" name="nexus_saas_cloudflare">
                        <setting help="API token with Zone:Read and DNS:Edit permissions" string="Cloudflare API Token">
                            <field name="saas_cloudflare_api_token" password="True"/>
                        </setting>
                        <setting help="Optional. If empty, zone is discovered from base domain" string="Cloudflare Zone ID">
                            <field name="saas_cloudflare_zone_id"/>
                        </setting>
                        <setting help="Target hostname for tenant CNAMEs, e.g. app.nexus-engine.app" string="CNAME Target">
                            <field name="saas_cloudflare_cname_target"/>
                        </setting>
                    </block>
                    <block title="Dedicated Database Provisioning" name="nexus_saas_db_provisioner">
                        <setting help="Shared secret sent by the external saas-db-provisioner service" string="Provisioner API Key">
                            <field name="saas_db_provisioner_api_key" password="True"/>
                        </setting>
                        <setting help="Comma-separated module list installed on every new dedicated tenant database" string="Default Modules">
                            <field name="saas_dedicated_db_default_modules"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
