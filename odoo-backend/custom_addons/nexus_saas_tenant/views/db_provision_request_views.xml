<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexus_saas_db_provision_request_list" model="ir.ui.view">
        <field name="name">nexus.saas.db.provision.request.list</field>
        <field name="model">nexus.saas.db.provision.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" decoration-success="state == 'done'" decoration-muted="state == 'in_progress'">
                <field name="tenant_id"/>
                <field name="request_type"/>
                <field name="target_db_name"/>
                <field name="state"/>
                <field name="requested_at"/>
                <field name="started_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_saas_db_provision_request_form" model="ir.ui.view">
        <field name="name">nexus.saas.db.provision.request.form</field>
        <field name="model">nexus.saas.db.provision.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" string="Retry" type="object" invisible="state != 'error'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tenant_id"/>
                            <field name="request_type"/>
                            <field name="target_db_name"/>
                            <field name="modules"/>
                        </group>
                        <group>
                            <field name="requested_at" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Provisioner Log">
                        <field name="log" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nexus_saas_db_provision_request" model="ir.actions.act_window">
        <field name="name">DB Provisioning Requests</field>
        <field name="res_model">nexus.saas.db.provision.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_nexus_saas_db_provision_requests"
        name="DB Provisioning"
        parent="menu_nexus_saas_root"
        action="action_nexus_saas_db_provision_request"
        groups="base.group_system"
        sequence="50"/>
</odoo>
