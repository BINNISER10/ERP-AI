<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexus_saas_usage_metric_list" model="ir.ui.view">
        <field name="name">nexus.saas.usage.metric.list</field>
        <field name="model">nexus.saas.usage.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_saas_usage_metric_form" model="ir.ui.view">
        <field name="name">nexus.saas.usage.metric.form</field>
        <field name="model">nexus.saas.usage.metric</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="technical_name"/>
                        <field name="unit"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nexus_saas_usage_record_list" model="ir.ui.view">
        <field name="name">nexus.saas.usage.record.list</field>
        <field name="model">nexus.saas.usage.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="tenant_id"/>
                <field name="metric_id"/>
                <field name="period_date"/>
                <field name="value"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_nexus_saas_usage_metric" model="ir.actions.act_window">
        <field name="name">Usage Metrics</field>
        <field name="res_model">nexus.saas.usage.metric</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nexus_saas_usage_record" model="ir.actions.act_window">
        <field name="name">Usage Records</field>
        <field name="res_model">nexus.saas.usage.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
