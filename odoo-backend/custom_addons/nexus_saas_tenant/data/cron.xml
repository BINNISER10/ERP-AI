<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_saas_usage_aggregate" model="ir.cron">
        <field name="name">SaaS: aggregate daily usage</field>
        <field name="model_id" ref="model_nexus_saas_usage_record"/>
        <field name="state">code</field>
        <field name="code">model._cron_aggregate_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_saas_subscription_check" model="ir.cron">
        <field name="name">SaaS: check subscription status</field>
        <field name="model_id" ref="model_nexus_saas_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_saas_trial_expiry" model="ir.cron">
        <field name="name">SaaS: expire trials</field>
        <field name="model_id" ref="model_nexus_saas_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_trial_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
