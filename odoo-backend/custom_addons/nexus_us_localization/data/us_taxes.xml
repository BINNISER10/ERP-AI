<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════════ US Sales Tax Templates ════════════════ -->

        <!-- Generic Sales Tax (rate to be set per-state) -->
        <record id="tax_us_sales_tax" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_us.us_chart_template"/>
            <field name="name">Sales Tax / ضريبة المبيعات</field>
            <field name="description">US-ST</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="l10n_us.tax_group_sales_tax"/>
            <field name="invoice_repartition_line_ids" eval="[
                (0, 0, {'repartition_type': 'base', 'factor_percent': 100.0}),
                (0, 0, {'repartition_type': 'tax', 'factor_percent': 100.0,
                       'account_id': ref('account_us_sales_tax_payable')}),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[
                (0, 0, {'repartition_type': 'base', 'factor_percent': 100.0}),
                (0, 0, {'repartition_type': 'tax', 'factor_percent': 100.0,
                       'account_id': ref('account_us_sales_tax_payable')}),
            ]"/>
        </record>

        <!-- Federal Withholding placeholder -->
        <record id="tax_us_federal_withhold" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_us.us_chart_template"/>
            <field name="name">Federal Tax Withholding</field>
            <field name="description">US-FW</field>
            <field name="amount">15.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
        </record>

        <!-- State Tax Withholding placeholder -->
        <record id="tax_us_state_withhold" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_us.us_chart_template"/>
            <field name="name">State Tax Withholding</field>
            <field name="description">US-SW</field>
            <field name="amount">5.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
        </record>

    </data>
</odoo>
