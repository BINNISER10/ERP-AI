<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexus_saas_scoping_request_list" model="ir.ui.view">
        <field name="name">nexus.saas.scoping.request.list</field>
        <field name="model">nexus.saas.scoping.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_name"/>
                <field name="sector_id"/>
                <field name="resource_tier"/>
                <field name="price_monthly"/>
                <field name="state" widget="badge"/>
                <field name="tenant_id"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_saas_scoping_request_form" model="ir.ui.view">
        <field name="name">nexus.saas.scoping.request.form</field>
        <field name="model">nexus.saas.scoping.request</field>
        <field name="arch" type="xml">
            <form string="Scoping Request">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="العميل">
                            <field name="company_name"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                            <field name="sector_id"/>
                        </group>
                        <group string="الحجم التشغيلي">
                            <field name="branches_count"/>
                            <field name="pos_count"/>
                            <field name="warehouse_main_count"/>
                            <field name="warehouse_sub_count"/>
                            <field name="employees_count"/>
                            <field name="has_manufacturing"/>
                            <field name="has_iot_integration"/>
                            <field name="has_ecommerce"/>
                        </group>
                    </group>
                    <group string="العرض المحسوب">
                        <field name="billing_interval"/>
                        <field name="resource_tier"/>
                        <field name="recommended_modules"/>
                        <field name="price_monthly"/>
                        <field name="price_yearly"/>
                        <field name="price_breakdown" widget="text"/>
                    </group>
                    <group string="الربط" invisible="not tenant_id">
                        <field name="tenant_id"/>
                        <field name="subscription_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nexus_saas_scoping_request" model="ir.actions.act_window">
        <field name="name">Scoping Requests</field>
        <field name="res_model">nexus.saas.scoping.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
