<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Party Accounts (nexus.party.account) ── -->
    <record id="view_nexus_party_account_form" model="ir.ui.view">
        <field name="name">nexus.party.account.form</field>
        <field name="model">nexus.party.account</field>
        <field name="arch" type="xml">
            <form string="Party Account">
                <sheet>
                    <group>
                        <group>
                            <field name="party_type"/>
                            <field name="party_id"/>
                        </group>
                        <group>
                            <field name="account_type"/>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nexus_party_account_list" model="ir.ui.view">
        <field name="name">nexus.party.account.list</field>
        <field name="model">nexus.party.account</field>
        <field name="arch" type="xml">
            <list string="Party Accounts" multi_edit="1">
                <field name="party_type"/>
                <field name="party_id"/>
                <field name="account_type"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_nexus_party_account" model="ir.actions.act_window">
        <field name="name">Party Accounts</field>
        <field name="res_model">nexus.party.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
