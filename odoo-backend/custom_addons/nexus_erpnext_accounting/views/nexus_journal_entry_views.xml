<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Journal Entries (nexus.journal.entry) ── -->
    <record id="view_nexus_journal_entry_form" model="ir.ui.view">
        <field name="name">nexus.journal.entry.form</field>
        <field name="model">nexus.journal.entry</field>
        <field name="arch" type="xml">
            <form string="Journal Entry">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state != 'submitted'" confirm="This will remove all GL entries created by this journal entry. Continue?"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                        invisible="state != 'cancelled'"/>
                    <button name="action_reverse" type="object" string="Reverse Entry"
                        invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_gl_entries" type="object"
                            class="oe_stat_button" icon="fa-list-alt">
                            <div class="o_stat_info">
                                <field name="gl_entry_count" class="o_stat_value"/>
                                <span class="o_stat_text">GL Entries</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="posting_date"/>
                            <field name="accounting_date"/>
                            <field name="voucher_type"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_currency_id" readonly="1" force_save="1"/>
                            <field name="fiscal_year_id" readonly="1"/>
                            <field name="is_opening"/>
                            <field name="multi_currency" readonly="1"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <field name="total_debit" string="Total Debit" readonly="1"/>
                        <field name="total_credit" string="Total Credit" readonly="1"/>
                        <field name="difference" string="Difference" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Entries" name="lines">
                            <field name="line_ids" mode="tree,form">
                                <list string="Journal Entries" editable="bottom" create="1" delete="1">
                                    <field name="account_id" string="Account"/>
                                    <field name="party_type" optional="hide"/>
                                    <field name="party_id" optional="show"/>
                                    <field name="cost_center_id" optional="show"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="debit_in_account_currency" string="Debit (Curr)" optional="hide"/>
                                    <field name="credit_in_account_currency" string="Credit (Curr)" optional="hide"/>
                                    <field name="remark" optional="hide"/>
                                </list>
                                <form string="Journal Entry Line">
                                    <group>
                                        <group>
                                            <field name="account_id" string="Account"/>
                                            <field name="party_type"/>
                                            <field name="party_id"/>
                                            <field name="cost_center_id"/>
                                            <field name="project_id"/>
                                        </group>
                                        <group>
                                            <field name="debit"/>
                                            <field name="credit"/>
                                            <field name="exchange_rate"/>
                                            <field name="remark"/>
                                            <field name="is_advance"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Remark" name="remark">
                            <field name="user_remark" placeholder="User Remark..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_nexus_journal_entry_list" model="ir.ui.view">
        <field name="name">nexus.journal.entry.list</field>
        <field name="model">nexus.journal.entry</field>
        <field name="arch" type="xml">
            <list string="Journal Entries">
                <field name="name" string="JE No"/>
                <field name="posting_date"/>
                <field name="voucher_type"/>
                <field name="reference"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="difference"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fiscal_year_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_journal_entry_search" model="ir.ui.view">
        <field name="name">nexus.journal.entry.search</field>
        <field name="model">nexus.journal.entry</field>
        <field name="arch" type="xml">
            <search string="Journal Entries">
                <field name="name"/>
                <field name="reference"/>
                <field name="voucher_type"/>
                <field name="line_ids"/>
                <filter name="not_cancelled" string="Not Cancelled"
                    domain="[('state', '!=', 'cancelled')]"/>
                <filter name="draft" string="Draft"
                    domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted"
                    domain="[('state', '=', 'submitted')]"/>
                <filter name="group_by_voucher_type" string="Group by Voucher Type"
                    context="{'group_by': 'voucher_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_nexus_journal_entry" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">nexus.journal.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nexus_journal_entry_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
    </record>
</odoo>
