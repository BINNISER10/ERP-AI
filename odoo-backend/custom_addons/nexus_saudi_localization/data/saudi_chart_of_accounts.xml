<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════════ Saudi Arabia Chart of Accounts Template ════════════════
             Based on the SOCPA-recommended structure adapted for Saudi SMEs.
             Five top-level groups: Assets, Liabilities, Equity, Revenue, Expenses.
        -->

        <!-- Top-level groups -->
        <record id="account_saudi_asset_root" model="account.account.template">
            <field name="code">1000</field>
            <field name="name">الأصول / Assets</field>
            <field name="account_type">asset_non_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_liability_root" model="account.account.template">
            <field name="code">2000</field>
            <field name="name">الخصوم / Liabilities</field>
            <field name="account_type">liability_non_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_equity_root" model="account.account.template">
            <field name="code">3000</field>
            <field name="name">حقوق الملكية / Equity</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_revenue_root" model="account.account.template">
            <field name="code">4000</field>
            <field name="name">الإيرادات / Revenue</field>
            <field name="account_type">income</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_expense_root" model="account.account.template">
            <field name="code">5000</field>
            <field name="name">المصروفات / Expenses</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Current Assets -->
        <record id="account_saudi_cash" model="account.account.template">
            <field name="code">1100</field>
            <field name="name">النقدية / Cash on Hand</field>
            <field name="account_type">asset_cash</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_bank" model="account.account.template">
            <field name="code">1110</field>
            <field name="name">البنوك / Banks</field>
            <field name="account_type">asset_bank</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="True"/>
        </record>

        <record id="account_saudi_receivable" model="account.account.template">
            <field name="code">1200</field>
            <field name="name">ذمم العملاء / Accounts Receivable</field>
            <field name="account_type">asset_receivable</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="True"/>
        </record>

        <record id="account_saudi_inventory" model="account.account.template">
            <field name="code">1300</field>
            <field name="name">المخزون / Inventory</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_prepayments" model="account.account.template">
            <field name="code">1400</field>
            <field name="name">المصروفات المقدمة / Prepayments</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_vat_input" model="account.account.template">
            <field name="code">1500</field>
            <field name="name">ضريبة مدخلات / VAT Input</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Fixed Assets -->
        <record id="account_saudi_fixed_assets" model="account.account.template">
            <field name="code">1600</field>
            <field name="name">الأصول الثابتة / Fixed Assets</field>
            <field name="account_type">asset_fixed</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_accumulated_dep" model="account.account.template">
            <field name="code">1650</field>
            <field name="name">مجمع الإهلاك / Accumulated Depreciation</field>
            <field name="account_type">asset_fixed</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Current Liabilities -->
        <record id="account_saudi_payable" model="account.account.template">
            <field name="code">2100</field>
            <field name="name">ذمم الموردين / Accounts Payable</field>
            <field name="account_type">liability_payable</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="True"/>
        </record>

        <record id="account_saudi_vat_output" model="account.account.template">
            <field name="code">2200</field>
            <field name="name">ضريبة مخرجات / VAT Output</field>
            <field name="account_type">liability_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_accrued_expenses" model="account.account.template">
            <field name="code">2300</field>
            <field name="name">مصروفات مستحقة / Accrued Expenses</field>
            <field name="account_type">liability_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_gosi_payable" model="account.account.template">
            <field name="code">2400</field>
            <field name="name">التأمينات الاجتماعية المستحقة / GOSI Payable</field>
            <field name="account_type">liability_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Long-term Liabilities -->
        <record id="account_saudi_long_term_loan" model="account.account.template">
            <field name="code">2500</field>
            <field name="name">قروض طويلة الأجل / Long-term Loans</field>
            <field name="account_type">liability_non_current</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Equity -->
        <record id="account_saudi_capital" model="account.account.template">
            <field name="code">3100</field>
            <field name="name">رأس المال / Share Capital</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_retained_earnings" model="account.account.template">
            <field name="code">3200</field>
            <field name="name">أرباح محتجزة / Retained Earnings</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_current_year_earnings" model="account.account.template">
            <field name="code">3300</field>
            <field name="name">أرباح السنة الحالية / Current Year Earnings</field>
            <field name="account_type">equity_unaffected</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Revenue -->
        <record id="account_saudi_sales" model="account.account.template">
            <field name="code">4100</field>
            <field name="name">مبيعات / Sales</field>
            <field name="account_type">income</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_service_revenue" model="account.account.template">
            <field name="code">4200</field>
            <field name="name">إيرادات خدمات / Service Revenue</field>
            <field name="account_type">income</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_other_income" model="account.account.template">
            <field name="code">4900</field>
            <field name="name">إيرادات أخرى / Other Income</field>
            <field name="account_type">income_other</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <!-- Expenses -->
        <record id="account_saudi_cogs" model="account.account.template">
            <field name="code">5100</field>
            <field name="name">تكلفة المبيعات / Cost of Goods Sold</field>
            <field name="account_type">expense_direct_cost</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_salaries" model="account.account.template">
            <field name="code">5200</field>
            <field name="name">رواتب وأجور / Salaries & Wages</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_rent" model="account.account.template">
            <field name="code">5300</field>
            <field name="name">إيجار / Rent</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_utilities" model="account.account.template">
            <field name="code">5400</field>
            <field name="name">كهرباء وماء / Utilities</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_depreciation" model="account.account.template">
            <field name="code">5500</field>
            <field name="name">مصاريف الإهلاك / Depreciation Expense</field>
            <field name="account_type">expense_depreciation</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

        <record id="account_saudi_admin_expenses" model="account.account.template">
            <field name="code">5900</field>
            <field name="name">مصاريف إدارية وعمومية / Admin Expenses</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="reconcile" eval="False"/>
        </record>

    </data>
</odoo>
