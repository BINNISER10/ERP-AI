<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════════ Saudi VAT Templates (15%) ════════════════ -->

        <!-- Output VAT (Sales) — Standard 15% -->
        <record id="tax_saudi_vat_sales_15" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="name">ضريبة القيمة المضافة 15% / VAT 15% (Sales)</field>
            <field name="description">VAT-S-15</field>
            <field name="amount">15.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="l10n_sa.sa_tax_group_vat_15"/>
            <field name="l10n_sa_tax_category" eval="'S'"/>
            <field name="invoice_repartition_line_ids" eval="[
                (0, 0, {
                    'repartition_type': 'base',
                    'factor_percent': 100.0,
                }),
                (0, 0, {
                    'repartition_type': 'tax',
                    'factor_percent': 100.0,
                    'account_id': ref('account_saudi_vat_output'),
                }),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[
                (0, 0, {
                    'repartition_type': 'base',
                    'factor_percent': 100.0,
                }),
                (0, 0, {
                    'repartition_type': 'tax',
                    'factor_percent': 100.0,
                    'account_id': ref('account_saudi_vat_output'),
                }),
            ]"/>
        </record>

        <!-- Input VAT (Purchases) — Standard 15% -->
        <record id="tax_saudi_vat_purchase_15" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="name">ضريبة القيمة المضافة 15% / VAT 15% (Purchases)</field>
            <field name="description">VAT-P-15</field>
            <field name="amount">15.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="l10n_sa.sa_tax_group_vat_15"/>
            <field name="l10n_sa_tax_category" eval="'S'"/>
            <field name="invoice_repartition_line_ids" eval="[
                (0, 0, {
                    'repartition_type': 'base',
                    'factor_percent': 100.0,
                }),
                (0, 0, {
                    'repartition_type': 'tax',
                    'factor_percent': 100.0,
                    'account_id': ref('account_saudi_vat_input'),
                }),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[
                (0, 0, {
                    'repartition_type': 'base',
                    'factor_percent': 100.0,
                }),
                (0, 0, {
                    'repartition_type': 'tax',
                    'factor_percent': 100.0,
                    'account_id': ref('account_saudi_vat_input'),
                }),
            ]"/>
        </record>

        <!-- Zero-rated VAT (Exports) -->
        <record id="tax_saudi_vat_zero" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="name">ضريبة صفر / Zero-Rated</field>
            <field name="description">VAT-Z</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="l10n_sa.sa_tax_group_vat_0"/>
            <field name="l10n_sa_tax_category" eval="'Z'"/>
        </record>

        <!-- Exempt VAT -->
        <record id="tax_saudi_vat_exempt" model="account.tax.template">
            <field name="chart_template_id" ref="l10n_sa.sa_chart_template_standard"/>
            <field name="name">معفى / Exempt</field>
            <field name="description">VAT-E</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="l10n_sa.sa_tax_group_vat_exempt"/>
            <field name="l10n_sa_tax_category" eval="'E'"/>
        </record>

    </data>
</odoo>
