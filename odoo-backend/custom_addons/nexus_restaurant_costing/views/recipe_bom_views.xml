<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recipe_bom_tree" model="ir.ui.view">
        <field name="name">recipe.bom.tree</field>
        <field name="model">recipe.bom</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="version"/>
                <field name="total_recipe_cost"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_recipe_bom_form" model="ir.ui.view">
        <field name="name">recipe.bom.form</field>
        <field name="model">recipe.bom</field>
        <field name="arch" type="xml">
            <form string="Recipe BOM">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="version"/>
                        <field name="total_recipe_cost" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Ingredients">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="standard_cost" readonly="1"/>
                                    <field name="ingredient_cost" readonly="1"/>
                                    <field name="is_modifiable"/>
                                    <field name="modifier_options" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recipe_bom" model="ir.actions.act_window">
        <field name="name">Recipe BOMs</field>
        <field name="res_model">recipe.bom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_restaurant_root" name="Restaurant" sequence="90"/>
    <menuitem id="menu_recipe_bom" name="Recipe BOMs" parent="menu_restaurant_root" action="action_recipe_bom" sequence="10"/>
</odoo>
