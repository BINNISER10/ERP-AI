<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuel_tank_tree" model="ir.ui.view">
        <field name="name">fuel.tank.tree</field>
        <field name="model">fuel.tank</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="capacity"/>
                <field name="current_volume"/>
                <field name="location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_tank_form" model="ir.ui.view">
        <field name="name">fuel.tank.form</field>
        <field name="model">fuel.tank</field>
        <field name="arch" type="xml">
            <form string="Fuel Tank">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="capacity"/>
                        <field name="current_volume"/>
                        <field name="location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuel_tank" model="ir.actions.act_window">
        <field name="name">Fuel Tanks</field>
        <field name="res_model">fuel.tank</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fuel_root" name="Fuel Station" sequence="50"/>
    <menuitem id="menu_fuel_tank" name="Tanks" parent="menu_fuel_root" action="action_fuel_tank" sequence="10"/>
</odoo>
