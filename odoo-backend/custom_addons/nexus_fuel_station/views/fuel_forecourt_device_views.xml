<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuel_forecourt_device_tree" model="ir.ui.view">
        <field name="name">fuel.forecourt.device.tree</field>
        <field name="model">fuel.forecourt.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="protocol"/>
                <field name="last_seen"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_forecourt_device_form" model="ir.ui.view">
        <field name="name">fuel.forecourt.device.form</field>
        <field name="model">fuel.forecourt.device</field>
        <field name="arch" type="xml">
            <form string="Forecourt Controller">
                <header>
                    <button name="action_rotate_api_key" type="object" string="Rotate API Key"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="protocol"/>
                        <field name="api_key" groups="base.group_system" password="True"/>
                        <field name="last_seen" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Pumps">
                            <field name="pump_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="nozzle_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuel_forecourt_device" model="ir.actions.act_window">
        <field name="name">Forecourt Controllers</field>
        <field name="res_model">fuel.forecourt.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fuel_forecourt_device" name="Forecourt Controllers" parent="menu_fuel_root" action="action_fuel_forecourt_device" sequence="40" groups="base.group_system"/>
</odoo>
