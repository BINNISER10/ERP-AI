<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuel_pump_tree" model="ir.ui.view">
        <field name="name">fuel.pump.tree</field>
        <field name="model">fuel.pump</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="meter_start"/>
                <field name="meter_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_pump_form" model="ir.ui.view">
        <field name="name">fuel.pump.form</field>
        <field name="model">fuel.pump</field>
        <field name="arch" type="xml">
            <form string="Fuel Pump">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tank_id"/>
                        <field name="product_id"/>
                        <field name="meter_start"/>
                        <field name="meter_end"/>
                        <field name="nozzle_count"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuel_pump" model="ir.actions.act_window">
        <field name="name">Fuel Pumps</field>
        <field name="res_model">fuel.pump</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fuel_pump" name="Pumps" parent="menu_fuel_root" action="action_fuel_pump" sequence="20"/>
</odoo>
