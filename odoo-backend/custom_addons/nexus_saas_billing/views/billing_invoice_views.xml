<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexus_saas_billing_invoice_list" model="ir.ui.view">
        <field name="name">nexus.saas.billing.invoice.list</field>
        <field name="model">nexus.saas.billing.invoice</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-danger="state == 'overdue'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="invoice_date"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_saas_billing_invoice_form" model="ir.ui.view">
        <field name="name">nexus.saas.billing.invoice.form</field>
        <field name="model">nexus.saas.billing.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" string="Post" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_mark_paid" string="Mark Paid" type="object" invisible="state in ('paid','cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,paid,overdue,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tenant_id"/>
                            <field name="subscription_id"/>
                            <field name="invoice_date"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                            <field name="stripe_invoice_id"/>
                            <field name="stripe_invoice_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Period">
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nexus_saas_billing_invoice" model="ir.actions.act_window">
        <field name="name">Billing Invoices</field>
        <field name="res_model">nexus.saas.billing.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
