<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nexus_sync_queue_form" model="ir.ui.view">
        <field name="name">nexus.sync.queue.form</field>
        <field name="model">nexus.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Nexus Core Outbound Record">
                <header>
                    <button name="action_process_now" string="Process Now" type="object" class="btn-primary"/>
                    <button name="action_retry" string="Retry" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="transaction_id"/>
                            <field name="http_method"/>
                            <field name="endpoint"/>
                            <field name="company_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="docname"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="last_attempt"/>
                            <field name="next_attempt"/>
                            <field name="done_date"/>
                        </group>
                    </group>
                    <group string="Nexus Core Payload">
                        <field name="payload" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                    </group>
                    <group string="Nexus Core Response">
                        <field name="response" nolabel="1"/>
                    </group>
                    <group string="Error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_nexus_sync_queue_list" model="ir.ui.view">
        <field name="name">nexus.sync.queue.list</field>
        <field name="model">nexus.sync.queue</field>
        <field name="arch" type="xml">
            <list string="Nexus Core Outbound Queue" multi_edit="1">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="priority"/>
                <field name="operation"/>
                <field name="transaction_id"/>
                <field name="endpoint"/>
                <field name="retry_count"/>
                <field name="last_error"/>
                <field name="last_attempt"/>
                <field name="next_attempt"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_nexus_sync_queue_search" model="ir.ui.view">
        <field name="name">nexus.sync.queue.search</field>
        <field name="model">nexus.sync.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="operation"/>
                <field name="transaction_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="processing" string="Processing" domain="[('state','=','processing')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <separator/>
                <filter name="due_now" string="Due Now"
                    domain="[('state','=','pending'),('next_attempt','&lt;=',context_today())]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_by_operation" string="Operation" context="{'group_by':'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexus_sync_queue" model="ir.actions.act_window">
        <field name="name">Nexus Core Outbound Queue</field>
        <field name="res_model">nexus.sync.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nexus_sync_queue_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem
        id="menu_nexus_sync_queue"
        name="Sync Queue"
        parent="menu_hybrid_config"
        action="action_nexus_sync_queue"
        sequence="110"/>

</odoo>
