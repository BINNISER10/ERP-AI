<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hybrid_config_form" model="ir.ui.view">
        <field name="name">hybrid.config.form</field>
        <field name="model">hybrid.config</field>
        <field name="arch" type="xml">
            <form string="Nexus Core Ledger Synchronization / مزامنة السجل المركزي">
                <sheet>
                    <div class="oe_title">
                        <h1>Nexus Core Ledger Synchronization</h1>
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <group string="السجل المحاسبي المركزي (Core Financial Ledger)">
                        <field name="erpnext_url" string="رابط السجل المركزي (Core Ledger URL)" placeholder="https://core.nexus-engine.app"/>
                        <field name="erpnext_api_key" string="مفتاح الربط (API Key)" password="True"/>
                        <field name="erpnext_api_secret" string="الرمز السري (API Secret)" password="True"/>
                    </group>
                    <group string="أتمتة العمليات (n8n Automation)">
                        <field name="n8n_url" string="رابط الأتمتة (Automation URL)" placeholder="https://n8n.nexus-engine.app"/>
                        <field name="n8n_webhook_key" string="مفتاح الويب هوك" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hybrid_config_list" model="ir.ui.view">
        <field name="name">hybrid.config.list</field>
        <field name="model">hybrid.config</field>
        <field name="arch" type="xml">
            <list string="Nexus Ledger Sync Configurations">
                <field name="company_id"/>
                <field name="erpnext_url" string="Core Ledger URL"/>
                <field name="n8n_url" string="Automation URL"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hybrid_config" model="ir.actions.act_window">
        <field name="name">Nexus Ledger Synchronization</field>
        <field name="res_model">hybrid.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hybrid_config"
        name="مزامنة السجل المركزي (Ledger Sync)"
        parent="base.menu_custom"
        action="action_hybrid_config"
        sequence="100"/>
</odoo>
