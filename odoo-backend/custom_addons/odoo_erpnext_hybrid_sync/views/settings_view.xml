<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hybrid_config_form" model="ir.ui.view">
        <field name="name">hybrid.config.form</field>
        <field name="model">hybrid.config</field>
        <field name="arch" type="xml">
            <form string="Hybrid ERP Sync">
                <sheet>
                    <div class="oe_title">
                        <h1>Hybrid ERP Sync</h1>
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <group string="ERPNext">
                        <field name="erpnext_url" placeholder="https://erp.nexus-engine.app"/>
                        <field name="erpnext_api_key" password="True"/>
                        <field name="erpnext_api_secret" password="True"/>
                    </group>
                    <group string="n8n">
                        <field name="n8n_url" placeholder="https://n8n.nexus-engine.app"/>
                        <field name="n8n_webhook_key" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hybrid_config_list" model="ir.ui.view">
        <field name="name">hybrid.config.list</field>
        <field name="model">hybrid.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="erpnext_url"/>
                <field name="n8n_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hybrid_config" model="ir.actions.act_window">
        <field name="name">Hybrid ERP Sync</field>
        <field name="res_model">hybrid.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hybrid_config"
        name="Hybrid Sync"
        parent="base.menu_custom"
        action="action_hybrid_config"
        sequence="100"/>
</odoo>
